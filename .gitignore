# 运行数据（md 主副本 + 派生索引，用户私有）
/data/
# 主密钥绝不入库
**/.master_key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# 本地 Embedding 资产（模型 ~2.3GB + 隔离 venv，由 setup 脚本自动补齐）
/embedding/models/
/embedding/venv/

# 前端（构建产物 app/static 入库，使用者免装 Node）
/frontend/node_modules/

# 原始需求文档（本地参考）
*.docx

# Langfuse 本地自托管源码已迁至工作区外同级目录（D:\project\langfuse-server）

# Langfuse 真实环境变量（含数据库密码/密钥，只入库 example 模板）
/langfuse-deploy/langfuse.env

# IDE 内部知识库
.qoder/

# 运行产物
*.pid
*.log
