# ============================================================
# Langfuse v2 本地自托管环境变量模板
# 用法：deploy-langfuse.ps1 首次运行时会自动把本文件复制为 langfuse.env
#       并随机生成 NEXTAUTH_SECRET / SALT / ENCRYPTION_KEY 三个安全密钥。
#       真实的 langfuse.env 已被 .gitignore 排除，绝不入库。
# ------------------------------------------------------------
# 【你要改的只有 1 行】把 DATABASE_URL 里的用户名/密码/端口改成你本机 PostgreSQL 的实际值
#   格式：postgresql://<用户>:<密码>@<主机>:<端口>/<数据库名>
#   数据库名建议用 langfuse（部署脚本会自动创建它）
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/langfuse
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/langfuse

# ---- 站点与端口（3000 被占用时可改 3001）----
NEXTAUTH_URL=http://localhost:3001
PORT=3001
HOSTNAME=0.0.0.0

# ---- 安全密钥（占位符，deploy-langfuse.ps1 会自动替换为随机值）----
NEXTAUTH_SECRET=__GENERATE__
SALT=__GENERATE__
ENCRYPTION_KEY=__GENERATE__

# ---- 关闭遥测 ----
TELEMETRY_ENABLED=false
LANGFUSE_DEFAULT_PROJECT_ROLE=ADMIN

# ---- Headless 初始化：首次启动自动建组织/项目/用户/API Key（免 UI 点击）----
# 注意：LANGFUSE_INIT_* 的值不要加引号；
#       PUBLIC/SECRET KEY 生成后需同步填入 Second Person 设置页（或 data/config.yaml）
LANGFUSE_INIT_ORG_ID=second-person-org
LANGFUSE_INIT_ORG_NAME=Second Person
LANGFUSE_INIT_PROJECT_ID=second-person
LANGFUSE_INIT_PROJECT_NAME=Second Person
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=__GENERATE__
LANGFUSE_INIT_PROJECT_SECRET_KEY=__GENERATE__
LANGFUSE_INIT_USER_EMAIL=admin@local.host
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME

# ---- Redis（langfuse worker 队列/缓存；本机 redis-server，无密码）----
REDIS_CONNECTION_STRING=redis://127.0.0.1:6379
